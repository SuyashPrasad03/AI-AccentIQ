<mxfile host="app.diagrams.net">
  <diagram name="AccentIQ v2 — Full Pipeline" id="accentiq-flow-v2">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ TITLE ═══ -->
        <mxCell id="title" value="AccentIQ v2 — Pronunciation Scoring &amp; Feedback Pipeline (Phases 24–34)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ═══ USER ═══ -->
        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="250" width="30" height="50" as="geometry" />
        </mxCell>

        <!-- ═══ FRONTEND LAYER ═══ -->
        <mxCell id="fe_box" value="FRONTEND (React + Tailwind v4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="500" height="380" as="geometry" />
        </mxCell>

        <!-- Upload/Record -->
        <mxCell id="upload" value="📁 Upload Audio&#xa;OR&#xa;🎤 Record (mic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="130" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_user_upload" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="user" target="upload" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Live Streaming -->
        <mxCell id="live_stream" value="🎙️ Live Practice Mode&#xa;(WebSocket streaming)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="200" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_user_live" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="user" target="live_stream" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Results View -->
        <mxCell id="results" value="📊 Results View&#xa;• Word scores (green/yellow/red)&#xa;• Per-phoneme detail&#xa;• Confidence badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="280" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Practice Plan UI -->
        <mxCell id="plan_ui" value="📋 Practice Plan&#xa;• 7-day adaptive plan&#xa;• Checkpoints&#xa;• Difficulty levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Admin Dashboard -->
        <mxCell id="admin_ui" value="🔍 Admin Dashboard&#xa;• Latency p50/p95&#xa;• Cost tracking&#xa;• Quality drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Live Word Feedback -->
        <mxCell id="live_words" value="Real-time word highlighting&#xa;🟢 correct 🟡 unclear 🔴 error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ═══ BACKEND LAYER ═══ -->
        <mxCell id="be_box" value="BACKEND (FastAPI + Python)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="80" width="550" height="550" as="geometry" />
        </mxCell>

        <!-- ASR/Transcription -->
        <mxCell id="asr" value="🔊 ASR (WhisperX / Deepgram)&#xa;→ Word timestamps + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_upload_asr" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="upload" target="asr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- wav2vec2-CTC -->
        <mxCell id="wav2vec" value="🧠 wav2vec2-CTC Phoneme Model&#xa;(facebook/wav2vec2-lv-60-espeak-cv-ft)&#xa;→ Frame-level log-posteriors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_asr_wav" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="asr" target="wav2vec" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- GOP Engine -->
        <mxCell id="gop" value="📐 GOP Scoring Engine&#xa;per-phoneme: log P(expected | frames)&#xa;CTC blank filtering + length-mark merging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_wav_gop" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="wav2vec" target="gop" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Score Normalizer -->
        <mxCell id="normalizer" value="📏 Score Normalizer&#xa;Raw GOP → 0-100 (calibrated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="680" y="350" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_gop_norm" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gop" target="normalizer" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Error Classifier -->
        <mxCell id="classifier" value="🌲 LightGBM Error Classifier&#xa;→ substitution | deletion | distortion&#xa;(trained on 3,541 samples)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="680" y="410" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_norm_class" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="normalizer" target="classifier" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Evidence Builder -->
        <mxCell id="evidence" value="📋 Evidence Builder&#xa;Structures GOP + errors for LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="950" y="190" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_class_ev" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="classifier" target="evidence" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- L1 Transfer Patterns -->
        <mxCell id="l1" value="🌍 L1 Transfer Patterns&#xa;5 languages, 18 patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="950" y="250" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- LLM Feedback -->
        <mxCell id="llm" value="🤖 Gemini (via OpenRouter)&#xa;Evidence-grounded prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="310" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e_ev_llm" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="evidence" target="llm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_l1_llm" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="l1" target="llm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Feedback Verifier -->
        <mxCell id="verifier" value="✅ Feedback Verifier&#xa;Rejects ungrounded claims&#xa;(max 2 retries → safe fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="950" y="375" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_llm_ver" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="llm" target="verifier" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Practice Planner -->
        <mxCell id="planner" value="🤖 Practice Planner Agent&#xa;Error history → 7-day plan&#xa;(curated sentence bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="950" y="450" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- RAG -->
        <mxCell id="rag" value="📚 RAG Assistant&#xa;Phonetics KB (10 entries)&#xa;+ Contextual trigger&#xa;+ Answer verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="950" y="520" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Observability -->
        <mxCell id="observability" value="📈 Observability&#xa;Per-stage latency + cost metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="680" y="520" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ═══ DATA LAYER ═══ -->
        <mxCell id="db_box" value="DATA LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="680" width="550" height="120" as="geometry" />
        </mxCell>

        <mxCell id="mysql" value="MySQL&#xa;• users (+ native_language)&#xa;• recordings&#xa;• scores / phoneme_scores" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;size=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="710" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mongo" value="MongoDB&#xa;• phoneme_analysis (+ gop_raw_scores)&#xa;• transcripts&#xa;• pipeline_metrics&#xa;• practice_plans&#xa;• kb_chunks" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;size=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="700" width="180" height="85" as="geometry" />
        </mxCell>

        <mxCell id="storage" value="File Storage&#xa;• Audio WAVs&#xa;• Model artifacts" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;size=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="710" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ CONNECTIONS (backend to results) ═══ -->
        <mxCell id="e_ver_results" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;" edge="1" source="verifier" target="results" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_live_be" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" source="live_stream" target="gop" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_live_words_out" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" source="gop" target="live_words" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_plan_ui" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="planner" target="plan_ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ═══ LEGEND ═══ -->
        <mxCell id="legend" value="LEGEND:&#xa;🟣 Purple = NEW in Phases 24-34&#xa;🟢 Green = Output/Result&#xa;🟡 Yellow = Existing (modified)&#xa;🔴 Red = External API / Admin" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Feature flag note -->
        <mxCell id="flag_note" value="⚙️ Feature Flag:&#xa;SCORING_ENGINE=gop|legacy&#xa;Both engines log side-by-side" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#991B1B;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="180" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
